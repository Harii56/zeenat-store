<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="product-detail">
    <div class="product-gallery">
      <div class="product-detail-image">
        <img id="mainProductImage" src="<%= item.image %>" alt="<%= item.name %>" />
      </div>
      <% if (item.images && item.images.length > 1) { %>
        <div class="gallery-thumbs">
          <% item.images.forEach(function(img, i) { %>
            <img src="<%= img %>" alt="<%= item.name %> view <%= i + 1 %>" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" onclick="document.getElementById('mainProductImage').src=this.src; document.querySelectorAll('.gallery-thumb').forEach(function(t){t.classList.remove('active')}); this.classList.add('active');" />
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="product-detail-info">
      <span class="eyebrow"><%= item.gender %> · <%= item.category %></span>
      <h1><%= item.name %></h1>

      <% if (item.rating) { %>
        <div class="product-rating detail-rating">
          <span class="stars" style="--rating: <%= item.rating %>;" aria-hidden="true">★★★★★</span>
          <span class="rating-count"><%= item.rating %> out of 5 (<%= item.reviewCount %> reviews)</span>
        </div>
      <% } %>

      <div class="product-detail-price"><%= formatPrice(item.price, item.currency) %></div>

      <% if (item.saleEndDate) { %>
        <p class="sale-note">⏳ Limited-time offer — ends <%= new Date(item.saleEndDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
      <% } %>

      <% if (item.colors && item.colors.length > 0) { %>
        <div class="option-group">
          <label class="option-label">Available Colors</label>
          <div class="color-swatches">
            <% item.colors.forEach(function(c) { %>
              <span class="color-swatch" style="background: <%= c.toLowerCase().replace(/\s+/g, '') %>;" title="<%= c %>"></span>
            <% }) %>
          </div>
          <p class="color-note"><%= item.colors.join(", ") %></p>
        </div>
      <% } %>

      <p class="product-detail-desc"><%= item.description %></p>

      <% if (item.affiliateLink) { %>
        <a href="<%= item.affiliateLink %>" target="_blank" rel="noopener sponsored" class="btn btn-primary btn-block">Buy Now</a>
        <p class="stock-note">Choose your preferred color &amp; size on the next page — you'll be taken to our partner store to complete this purchase.</p>
      <% } else { %>
        <form action="/cart/add" method="POST">
          <input type="hidden" name="productId" value="<%= item.id %>" />

          <div class="option-group">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <label class="option-label" style="margin-bottom:0;">Select Size</label>
              <button type="button" class="size-chart-link" onclick="document.getElementById('sizeChartModal').classList.add('open')">Size Chart</button>
            </div>
            <div class="size-options">
              <% item.sizes.forEach(function(s, i) { %>
                <input type="radio" name="size" id="size-<%= i %>" value="<%= s %>" <%= i === 0 ? "checked" : "" %> />
                <label for="size-<%= i %>"><%= s %></label>
              <% }) %>
            </div>
          </div>

          <div class="option-group">
            <label class="option-label">Quantity</label>
            <div class="qty-row">
              <input type="number" name="qty" value="1" min="1" max="<%= item.stock %>" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Add to Cart</button>
        </form>

        <p class="stock-note"><%= item.stock %> in stock — ready to ship</p>
      <% } %>
    </div>
  </div>

  <% if (related.length > 0) { %>
    <div class="section-head">
      <h2>You May Also Like</h2>
    </div>
    <div class="product-grid">
      <% related.forEach(function(p) { %>
        <%- include('partials/product-card', { p }) %>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Size Chart Modal -->
<div class="modal-overlay" id="sizeChartModal">
  <div class="modal-box">
    <button class="modal-close" onclick="document.getElementById('sizeChartModal').classList.remove('open')">&times;</button>
    <h3>Size Chart</h3>
    <table class="size-chart-table">
      <thead>
        <tr><th>Size</th><th>Chest (in)</th><th>Waist (in)</th><th>Length (in)</th></tr>
      </thead>
      <tbody>
        <tr><td>XS</td><td>32</td><td>26</td><td>25</td></tr>
        <tr><td>S</td><td>34</td><td>28</td><td>26</td></tr>
        <tr><td>M</td><td>36</td><td>30</td><td>27</td></tr>
        <tr><td>L</td><td>38</td><td>32</td><td>28</td></tr>
        <tr><td>XL</td><td>40</td><td>34</td><td>29</td></tr>
      </tbody>
    </table>
    <p class="size-chart-note">Measurements are approximate. For a relaxed fit, we recommend sizing up.</p>
  </div>
</div>

<%- include('partials/footer') %>
