<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container">
  <div class="success-box">
    <div class="check">&#10003;</div>
    <h1>Order Confirmed!</h1>
    <p style="color:var(--color-text-muted); margin-top:14px;">Thank you, <%= order.shippingInfo.fullName %>. Your order has been placed successfully.</p>
    <div class="order-id">Order ID: #<%= order.id %></div>

    <div class="order-summary-box" style="text-align:left;">
      <% order.items.forEach(function(i) { %>
        <div class="order-summary-item">
          <span><strong><%= i.name %></strong> × <%= i.qty %> (<%= i.size %>)</span>
          <span><%= formatPrice(i.subtotal, i.currency) %></span>
        </div>
      <% }) %>
      <div class="summary-row total">
        <span>Total Paid</span>
        <span><%= formatPrice(order.total, 'PKR') %></span>
      </div>
      <p style="font-size:12px; color:var(--color-text-muted); margin-top:16px;">
        Payment method: <%= order.paymentMethod %><br/>
        Delivering to: <%= order.shippingInfo.address %>, <%= order.shippingInfo.city %>
      </p>
    </div>

    <a href="/shop" class="btn btn-primary" style="margin-top:30px;">Continue Shopping</a>
  </div>
</div>

<%- include('partials/footer') %>
