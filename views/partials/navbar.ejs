<nav class="navbar">
  <div class="nav-inner">
    <button class="mobile-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
    <a href="/" class="brand">Zee<span>nat</span></a>

    <ul class="nav-links">
      <% ["women", "men", "kids"].forEach(function(g) { %>
        <li class="nav-item">
          <span class="nav-link">
            <%= g %>
            <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
          </span>
          <div class="dropdown">
            <a href="/shop?gender=<%= g %>">All <%= g %></a>
            <% categoriesForGender(g).forEach(function(c) { %>
              <a href="/shop?gender=<%= g %>&category=<%= c %>"><%= c %></a>
            <% }) %>
          </div>
        </li>
      <% }) %>
      <li class="nav-item"><a class="nav-link" href="/shop">Shop All</a></li>
    </ul>

    <div class="nav-actions">
      <div class="search-wrap">
        <form class="search-form" action="/shop" method="GET" autocomplete="off" id="searchForm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" name="search" id="searchInput" placeholder="Search..." />
        </form>
        <div class="search-suggestions" id="searchSuggestions"></div>
      </div>

      <% if (currentUser) { %>
        <a href="/profile" class="icon-btn" title="My Profile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
          <span class="icon-label">Account</span>
        </a>
        <a href="/logout" class="icon-btn" title="Logout">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
        </a>
      <% } else { %>
        <a href="/login" class="icon-btn" title="Login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
          <span class="icon-label">Login</span>
        </a>
        <a href="/register" class="icon-btn" title="Sign Up">
          <span class="icon-label">Sign Up</span>
        </a>
      <% } %>

      <a href="/cart" class="icon-btn" title="Cart">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        <% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
      </a>
    </div>
  </div>
</nav>

<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="container" style="padding-top: 20px;">
    <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
  </div>
<% } %>
